<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>TaxonomyNode.Default</Name>
      <ViewSelectedBy>
        <TypeName>TaxonomyNode</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Id</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>Label</Label><Width>50</Width></TableColumnHeader>
          <TableColumnHeader><Label>Description</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <Wrap/>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Label</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Description</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>TaxonomyNode.Similar</Name>
      <ViewSelectedBy>
        <TypeName>TaxonomyNode.Similar</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Score</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>Id</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>Label</Label><Width>44</Width></TableColumnHeader>
          <TableColumnHeader><Label>Description</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <Wrap/>
            <TableColumnItems>
              <TableColumnItem>
                <ScriptBlock>'{0:P0}' -f $_.Score</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Label</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Description</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>AITSource.Default</Name>
      <ViewSelectedBy>
        <TypeName>AITSource</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><Label>Title</Label><PropertyName>Title</PropertyName></ListItem>
              <ListItem><Label>OneLiner</Label><PropertyName>OneLiner</PropertyName></ListItem>
              <ListItem><Label>Id</Label><PropertyName>Id</PropertyName></ListItem>
              <ListItem><Label>SummaryUpdated</Label><PropertyName>SummaryUpdated</PropertyName></ListItem>
              <ListItem><Label>ImportTime</Label><PropertyName>ImportTime</PropertyName></ListItem>
              <ListItem><Label>TopicTags</Label><ScriptBlock>$_.TopicTags -join ', '</ScriptBlock></ListItem>
              <ListItem><Label>TotalClaims</Label><PropertyName>TotalClaims</PropertyName></ListItem>
              <ListItem><Label>TotalFacts</Label><PropertyName>TotalFacts</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>AITriad.TaxonomyNode.Beliefs</Name>
      <ViewSelectedBy>
        <TypeName>AITriad.TaxonomyNode.Beliefs</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Id</Label><Width>20</Width></TableColumnHeader>
          <TableColumnHeader><Label>Conf</Label><Width>5</Width></TableColumnHeader>
          <TableColumnHeader><Label>Label</Label><Width>46</Width></TableColumnHeader>
          <TableColumnHeader><Label>Description</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <Wrap/>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>'{0:P0}' -f $_.Confidence</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Label</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Description</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>AITriad.TaxonomyNode.Desires</Name>
      <ViewSelectedBy>
        <TypeName>AITriad.TaxonomyNode.Desires</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Id</Label><Width>20</Width></TableColumnHeader>
          <TableColumnHeader><Label>Pri</Label><Width>4</Width></TableColumnHeader>
          <TableColumnHeader><Label>Label</Label><Width>46</Width></TableColumnHeader>
          <TableColumnHeader><Label>Description</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <Wrap/>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Priority</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Label</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Description</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>AITriad.TaxonomyNode.Intentions</Name>
      <ViewSelectedBy>
        <TypeName>AITriad.TaxonomyNode.Intentions</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Id</Label><Width>20</Width></TableColumnHeader>
          <TableColumnHeader><Label>Oper</Label><Width>5</Width></TableColumnHeader>
          <TableColumnHeader><Label>Label</Label><Width>46</Width></TableColumnHeader>
          <TableColumnHeader><Label>Description</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <Wrap/>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Operationality</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Label</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Description</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>AITriad.PovInfo.Default</Name>
      <ViewSelectedBy>
        <TypeName>AITriad.PovInfo</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label><Width>18</Width></TableColumnHeader>
          <TableColumnHeader><Label>Color</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>Nodes</Label><Width>6</Width></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ColorHex</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>NodeCount</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>AITriad.CategoryInfo.Default</Name>
      <ViewSelectedBy>
        <TypeName>AITriad.CategoryInfo</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label><Width>14</Width></TableColumnHeader>
          <TableColumnHeader><Label>POV</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>Nodes</Label><Width>6</Width></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>POV</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>NodeCount</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>GhcrImage.Default</Name>
      <ViewSelectedBy>
        <TypeName>GhcrImage</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Tags</Label><Width>30</Width></TableColumnHeader>
          <TableColumnHeader><Label>Digest</Label><Width>22</Width></TableColumnHeader>
          <TableColumnHeader><Label>KnownGood</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>CreatedAt</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><ScriptBlock>$_.Tags -join ', '</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Digest.Length -gt 21) { $_.Digest.Substring(0, 21) + [char]0x2026 } else { $_.Digest }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>IsKnownGood</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>CreatedAt</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>BlobInfo.Default</Name>
      <ViewSelectedBy>
        <TypeName>BlobInfo</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Container</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>Name</Label><Width>50</Width></TableColumnHeader>
          <TableColumnHeader><Label>Size</Label><Width>10</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Deleted</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>LastModified</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Container</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Size -ge 1MB) { '{0:N1} MB' -f ($_.Size / 1MB) } elseif ($_.Size -ge 1KB) { '{0:N1} KB' -f ($_.Size / 1KB) } else { "$($_.Size) B" }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Deleted</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>LastModified</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>CriticalInteraction.Default</Name>
      <ViewSelectedBy>
        <TypeName>CriticalInteraction</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Id</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>Pri</Label><Width>4</Width></TableColumnHeader>
          <TableColumnHeader><Label>Domain</Label><Width>12</Width></TableColumnHeader>
          <TableColumnHeader><Label>Level</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>API</Label><Width>4</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>UX</Label><Width>4</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Title</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Priority</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Domain</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Level</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ApiChecks</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>UxSteps</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Title</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>DataCommit.Default</Name>
      <ViewSelectedBy>
        <TypeName>DataCommit</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Sha</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Author</Label><Width>20</Width></TableColumnHeader>
          <TableColumnHeader><Label>Date</Label><Width>22</Width></TableColumnHeader>
          <TableColumnHeader><Label>Message</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ShortSha</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Author</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Date</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Message</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>AcaRevision.Default</Name>
      <ViewSelectedBy>
        <TypeName>AcaRevision</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label><Width>50</Width></TableColumnHeader>
          <TableColumnHeader><Label>Active</Label><Width>7</Width></TableColumnHeader>
          <TableColumnHeader><Label>Traffic</Label><Width>8</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>State</Label><Width>12</Width></TableColumnHeader>
          <TableColumnHeader><Label>ImageTag</Label><Width>40</Width></TableColumnHeader>
          <TableColumnHeader><Label>CreatedAt</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Active</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>'{0}%' -f $_.TrafficWeight</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>RunningState</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ImageTag</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>CreatedAt</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>TaxEditorHealthResult.Default</Name>
      <ViewSelectedBy>
        <TypeName>TaxEditorHealthResult</TypeName>
      </ViewSelectedBy>
      <CustomControl>
        <CustomEntries>
          <CustomEntry>
            <CustomItem>
              <Text>BaseUrl   : </Text>
              <ExpressionBinding><PropertyName>BaseUrl</PropertyName></ExpressionBinding>
              <NewLine/>
              <Text>Healthy   : </Text>
              <ExpressionBinding><PropertyName>Healthy</PropertyName></ExpressionBinding>
              <NewLine/>
              <Text>AverageMs : </Text>
              <ExpressionBinding><PropertyName>AverageMs</PropertyName></ExpressionBinding>
              <NewLine/>
              <Text>Timestamp : </Text>
              <ExpressionBinding><PropertyName>Timestamp</PropertyName></ExpressionBinding>
              <NewLine/>
              <Text>Checks:</Text>
              <NewLine/>
              <ExpressionBinding>
                <ScriptBlock>($_.Checks | Format-Table Endpoint, Purpose, Status, Healthy, Ms, Detail -AutoSize | Out-String).TrimEnd()</ScriptBlock>
              </ExpressionBinding>
              <NewLine/>
            </CustomItem>
          </CustomEntry>
        </CustomEntries>
      </CustomControl>
    </View>
    <View>
      <Name>HealthCheck.Default</Name>
      <ViewSelectedBy>
        <TypeName>HealthCheck</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Endpoint</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Purpose</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label><Width>7</Width></TableColumnHeader>
          <TableColumnHeader><Label>Healthy</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>Ms</Label><Width>6</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Detail</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Endpoint</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Purpose</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Healthy</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Ms</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Detail</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>EndpointTestResult.Default</Name>
      <ViewSelectedBy>
        <TypeName>EndpointTestResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Pass</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label><Width>7</Width></TableColumnHeader>
          <TableColumnHeader><Label>Ms</Label><Width>6</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Endpoint</Label><Width>30</Width></TableColumnHeader>
          <TableColumnHeader><Label>Description</Label><Width>28</Width></TableColumnHeader>
          <TableColumnHeader><Label>NodeCount</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Error</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><ScriptBlock>if ($_.Pass) { 'OK' } else { 'FAIL' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Ms</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Endpoint</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Description</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>NodeCount</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Error</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
