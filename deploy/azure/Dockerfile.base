# syntax=docker/dockerfile:1.7

# AI Triad Base Image — heavy system dependencies, rebuilt monthly.
#
# Contains: Node 22, system packages, Python ML venv (torch,
# sentence-transformers, pre-downloaded embedding model), and the aitriad
# non-root user. No application code.
#
# Build:
#   docker build -f deploy/azure/Dockerfile.base -t ghcr.io/jpsnover/ai-triad-base:latest .
#
# The app Dockerfile (taxonomy-editor/Dockerfile) uses this as its runtime base.

FROM node:22-bookworm-slim

LABEL org.opencontainers.image.source="https://github.com/jpsnover/ai-triad-research"
LABEL org.opencontainers.image.description="AI Triad Research — base image with Node 22, Python ML"
LABEL org.opencontainers.image.licenses="MIT"

# System dependencies (runtime only — build tools like make/g++ live in the app
# Dockerfile's builder stage, not here).
# hadolint ignore=DL3008,DL3009
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
    git \
    pandoc \
    python3 \
    python3-pip \
    python3-venv \
    poppler-utils \
    curl \
    libicu72 \
    tini \
    && rm -rf /var/lib/apt/lists/*

# Python ML environment (isolated venv, CPU-only PyTorch)
RUN python3 -m venv /opt/ml-env
ENV PATH="/opt/ml-env/bin:$PATH"
# Install typing-extensions from PyPI first — the PyTorch CPU index has
# metadata inconsistency (underscore vs hyphen) that breaks pip 24+.
# hadolint ignore=DL3013
RUN pip install --no-cache-dir "typing-extensions>=4.10.0"
RUN pip install --no-cache-dir \
    torch==2.6.0 --index-url https://download.pytorch.org/whl/cpu

# Python dependencies — pinned versions for reproducible builds.
# Update pins: pip-compile --output-file=scripts/requirements-lock.txt scripts/requirements.txt
COPY scripts/requirements-lock.txt /tmp/requirements-lock.txt
RUN pip install --no-cache-dir -r /tmp/requirements-lock.txt && rm /tmp/requirements-lock.txt

# Pre-download embedding model (~90 MB) so first app start is fast.
# Skip in CI smoke tests where embeddings aren't needed and HuggingFace may be unreachable.
ARG PRELOAD_MODEL=true
RUN if [ "$PRELOAD_MODEL" = "true" ]; then \
      python3 -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')" \
      || echo "WARNING: model pre-download failed — will download on first use"; \
    fi

# Non-root user
RUN groupadd -r aitriad && useradd -r -g aitriad -d /home/aitriad -m aitriad \
    && chown -R aitriad:aitriad /opt/ml-env \
    && mkdir -p /home/aitriad/.cache /home/aitriad/.config /home/aitriad/.local/share \
    && chown -R aitriad:aitriad /home/aitriad
ENV XDG_CACHE_HOME=/home/aitriad/.cache
ENV XDG_CONFIG_HOME=/home/aitriad/.config
ENV XDG_DATA_HOME=/home/aitriad/.local/share
