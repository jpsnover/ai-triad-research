{
  "name": "taxonomy-editor",
  "version": "0.13.6",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "description": "Visual editor for AI Triad Research taxonomy JSON files",
  "homepage": "https://github.com/jpsnover/ai-triad-research",
  "author": {
    "name": "Jeffrey Snover",
    "email": "jsnover13@gmail.com"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "main": "dist/main/taxonomy-editor/src/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:web": "cross-env VITE_TARGET=web vite --host 0.0.0.0",
    "dev:server": "npm run build:server && node dist/server/taxonomy-editor/src/server/server.js",
    "dev:container": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build:main": "node -e \"const fs=require('fs');fs.rmSync('dist/main',{recursive:true,force:true});fs.rmSync('.tsbuildinfo/main.tsbuildinfo',{force:true})\" && tsc -p tsconfig.main.json",
    "licenses": "generate-license-file --input package.json --output THIRD-PARTY-NOTICES.txt --eol lf && node scripts/parse-licenses.cjs",
    "build": "npm run build:main && vite build && npm run licenses",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "build:server": "node -e \"const fs=require('fs');fs.rmSync('dist/server',{recursive:true,force:true});fs.rmSync('.tsbuildinfo/server.tsbuildinfo',{force:true})\" && tsc -p tsconfig.server.json",
    "build:web": "cross-env VITE_TARGET=web vite build",
    "build:container": "npm run build:server && npm run build:web && npm run licenses",
    "start:server": "node dist/server/taxonomy-editor/src/server/server.js",
    "postinstall": "npx @electron/rebuild || exit 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "depgraph": "node scripts/depgraph.mjs --stats",
    "depgraph:query": "node scripts/depgraph.mjs --query",
    "depgraph:reverse": "node scripts/depgraph.mjs --reverse",
    "depgraph:orphans": "node scripts/depgraph.mjs --orphans",
    "depcruise": "depcruise --config .dependency-cruiser.cjs src/ ../lib/",
    "verify": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.server.json --noEmit && bash scripts/check-renderer-tsc.sh && eslint src/ --max-warnings=4256 && npm run depcruise && vitest run && vite build"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/storage-blob": "^12.33.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "decode-named-character-reference": "^1.3.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "micromark-util-decode-numeric-character-reference": "^2.0.2",
    "node-pty": "^1.1.0",
    "onnxruntime-node": "^1.27.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "6.28.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mdast": "^4.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "azurite": "^3.35.0",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^18.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "generate-license-file": "^4.2.1",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "unified": "^11.0.5",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "axios": ">=1.8.4",
    "adm-zip": ">=0.6.0",
    "sharp": ">=0.35.0",
    "fast-xml-parser": ">=5.10.1"
  }
}
