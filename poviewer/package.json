{
  "name": "poviewer",
  "version": "0.1.0",
  "private": true,
  "description": "Three-pane POV viewer for BKC AI Triad research documents",
  "main": "dist/main/poviewer/src/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5174 && electron .",
    "build:main": "tsc -p tsconfig.main.json",
    "licenses": "generate-license-file --input package.json --output THIRD-PARTY-NOTICES.txt --eol lf",
    "build": "tsc -p tsconfig.main.json && vite build && npm run licenses"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "generate-license-file": "^4.2.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "wait-on": "^9.1.0"
  }
}
